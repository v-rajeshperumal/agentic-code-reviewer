+import { Router } from "express";
+import { auditLog } from "../services/audit";
+
+export const router = Router();
+
+router.post("/v1/webhooks/stripe", async (req, res) => {
+  auditLog.write({ type: req.body.type, receivedAt: Date.now() });
+  res.status(204).end();
+});
