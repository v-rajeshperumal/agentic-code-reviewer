diff --git a/api/payments.py b/api/payments.py
new file mode 100644
--- /dev/null
+++ b/api/payments.py
@@ -0,0 +1,13 @@
+from fastapi import APIRouter, Header, HTTPException
+from api.schemas import PaymentRequest
+from services.processor import processor
+
+router = APIRouter()
+
+
+@router.post("/v1/payments")
+async def create_payment(body: PaymentRequest, idempotency_key: str | None = Header(None)):
+    if not idempotency_key:
+        raise HTTPException(status_code=400, detail="Idempotency-Key header is required")
+    result = await processor.charge(body.customer_id, body.amount_cents, idempotency_key)
+    return {"payment_id": result.id, "status": result.status}
