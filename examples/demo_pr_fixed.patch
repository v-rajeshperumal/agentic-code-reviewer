@@ -0,0 +1,10 @@
+import logging
+
+from services.mailer import mailer
+
+logger = logging.getLogger(__name__)
+
+
+async def send_receipt(user, payment):
+    await mailer.send(to=user.email, template="payment_receipt", payment_id=payment.id)
+    logger.info("Receipt sent payment_id=%s user_uuid=%s", payment.id, user.uuid)
